{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "fonts": {
    "family": "Inter"
  },
  "background": {
    "decoration": "grid"
  },
  "redirects": [],
  "appearance": {
    "default": "dark",
    "strict": true
  },

  "name": "Aurora Docs",
  "description": "Official documentation for Project Aurora.",
  "colors": {
    "primary": "#FF2525",
    "light": "#ff5454",
    "dark": "#cc0b0b"
  },
  "favicon": "/assets/logo/aurora.svg",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Discord",
          "icon": "discord",
          "href": "https://discord.gg/projectaurora"
        }
      ]
    },
    "directory": "card",
    "pages": [
      "pages/home/introduction",
      {
        "group": "Product",
        "pages": [
          "pages/product/executors",
          {
            "group": "Features",
            "icon": "list",
            "pages": [
              "pages/product/counterblox",
              "pages/product/universal"
            ]
          }
        ]
      },
      {
        "group": "Legal",
        "pages": [
          "pages/legal/tos",
          "pages/legal/privacy-policy"
        ]
      }
    ]
  },
  "logo": {
    "light": "/assets/logo/aurora.svg",
    "dark": "/assets/logo/aurora.svg",
    "height": 20
  },
  "footer": {
    "socials": {
      "discord": "https://discord.gg/projectaurora"
    }
  }
}
